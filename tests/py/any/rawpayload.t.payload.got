# @ih,58,6 set 0 @ih,86,6 set 0 @ih,170,22 set 0
inet test-inet input
  [ payload load 2b @ inner header + 7 => reg 1 ]
  [ bitwise reg 1 = ( reg 1 & 0x0000ffc0 ) ^ 0x00000000 ]
  [ payload write reg 1 => 2b @ inner header + 7 csum_type 0 csum_off 0 csum_flags 0x1 ]
  [ payload load 3b @ inner header + 10 => reg 1 ]
  [ bitwise reg 1 = ( reg 1 & 0x00ff0ffc ) ^ 0x00000000 ]
  [ payload write reg 1 => 3b @ inner header + 10 csum_type 0 csum_off 0 csum_flags 0x1 ]
  [ payload load 4b @ inner header + 21 => reg 1 ]
  [ bitwise reg 1 = ( reg 1 & 0xff0000c0 ) ^ 0x00000000 ]
  [ payload write reg 1 => 4b @ inner header + 21 csum_type 0 csum_off 0 csum_flags 0x1 ]
