# icmp code != { prot-unreachable, frag-needed, 33, 54, 56}
[
    {
        "match": {
            "left": {
                "payload": {
                    "field": "code",
                    "protocol": "icmp"
                }
            },
            "op": "!=",
            "right": {
                "set": [
                    2,
                    4,
                    33,
                    54,
                    56
                ]
            }
        }
    }
]

