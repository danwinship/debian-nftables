# hbh hdrlength 33-45
inet test-inet filter-input
  [ meta load nfproto => reg 1 ]
  [ cmp eq reg 1 0x0000000a ]
  [ exthdr load ipv6 1b @ 0 + 1 => reg 1 ]
  [ range eq reg 1 0x00000021 0x0000002d ]
# hbh nexthdr 33-45
inet test-inet filter-input
  [ meta load nfproto => reg 1 ]
  [ cmp eq reg 1 0x0000000a ]
  [ exthdr load ipv6 1b @ 0 + 0 => reg 1 ]
  [ range eq reg 1 0x00000021 0x0000002d ]
