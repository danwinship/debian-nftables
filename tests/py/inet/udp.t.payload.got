# udp sport 50-70 accept
ip test-ip4 input
  [ meta load l4proto => reg 1 ]
  [ cmp eq reg 1 0x00000011 ]
  [ payload load 2b @ transport header + 0 => reg 1 ]
  [ range eq reg 1 0x00003200 0x00004600 ]
  [ immediate reg 0 accept ]
