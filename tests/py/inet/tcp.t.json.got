# tcp flags & (fin | syn | rst | ack) != syn | ack
[
    {
        "match": {
            "left": {
                "&": [
                    {
                        "payload": {
                            "field": "flags",
                            "protocol": "tcp"
                        }
                    },
                    {
                        "|": [
                            {
                                "|": [
                                    {
                                        "|": [
                                            "fin",
                                            "syn"
                                        ]
                                    },
                                    "rst"
                                ]
                            },
                            "ack"
                        ]
                    }
                ]
            },
            "op": "!=",
            "right": {
                "|": [
                    "syn",
                    "ack"
                ]
            }
        }
    }
]

